# Copy to infra/.env on the VPS and run chmod 600. Never commit the .env file.
# The repos are public: a secret committed once stays public forever and must be rotated.
# No *_BIND_IP may be 0.0.0.0.
HEALTH_BIND_IP=127.0.0.1
TS_HOSTNAME=platform.example.ts.net

# Postgres (plan 10). Fictitious values: the real ones live only in infra/.env on the VPS.
# Postgres stays on 127.0.0.1 and is exposed on the tailnet by `tailscale serve --tcp=5432`
# (ADR 0003). Never 0.0.0.0.
POSTGRES_ADMIN_USER=platform_admin
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_BIND_IP=127.0.0.1
# Password of the ingestor role (set on the server in item 12). Fake value.
POSTGRES_INGESTOR_PASSWORD=change-me-ingestor
